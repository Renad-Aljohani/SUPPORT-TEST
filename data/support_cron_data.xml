<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FR-SYS-18 / FR-SYS-19 / BR-20 / BR-21:
         تحديد الطلبات المتجاوزة وتنبيه مسؤول الدعم عند الاقتراب من التجاوز.
         noupdate حتى يستطيع مدير النظام ضبط التكرار دون أن يُستبدل عند التحديث. -->
    <data noupdate="1">
        <record id="ir_cron_support_sla_update" model="ir.cron">
            <field name="name">Support: تحديث حالة SLA وتنبيهات التجاوز</field>
            <field name="model_id" ref="model_support_ticket"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_sla_statuses()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
